# ==========================================================
# SMART-SANITATION eSOS LOCAL SERVER ENVIRONMENT VARIABLES
# ==========================================================

# Server Host & Port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENV=development

# Database Settings
DATABASE_TYPE=sqlite
DATABASE_PATH=data/esos_telemetry.db

# LoRa Gateway Settings
LORA_GATEWAY_SERIAL_PORT=/dev/ttyUSB0
LORA_GATEWAY_BAUD_RATE=115200

# Telemetry Alert Thresholds
ALERT_AMMONIA_PPM_LIMIT=25.0
ALERT_H2S_PPM_LIMIT=10.0
ALERT_WATER_LOW_CM=20.0
ALERT_BATTERY_LOW_VOLT=3.4

# API Security
API_SECRET_KEY=esos_secret_key_ftui_2026
ALLOW_CORS_ORIGINS=["*"]
